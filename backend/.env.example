NODE_ENV=development

HOST=0.0.0.0
PORT=3000

CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gettalk
SESSION_SECRET=change-me-in-production
# Optional dedicated encryption key for MFA secrets; keep it stable and backed up.
MFA_ENCRYPTION_KEY=
REDIS_URL=redis://127.0.0.1:6379

# ── Shared Upstash Redis Kill Switch (Controlled by SIEM SecAdmin) ───────────
# When `siem:backend:enabled` is set to "false" in Upstash Redis by SecAdmin,
# this chat server rejects /api/* requests with 503 Service Unavailable and blocks Socket.IO.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KILL_SWITCH_REDIS_KEY=siem:backend:enabled
KILL_SWITCH_CACHE_TTL_MS=1000

# ── Encrypted Attachment Storage & Pre-signed URLs ──────────────────────────
# STORAGE_DRIVER: 'local' (disk + HMAC pre-signed URL) or 's3' (MinIO / Supabase Storage / R2 / AWS S3)
STORAGE_DRIVER=local
STORAGE_DIR=storage
ATTACHMENT_URL_TTL_SECONDS=300
ATTACHMENT_URL_SECRET=

# S3-compatible configuration (required only when STORAGE_DRIVER=s3):
# - Supabase Storage S3: https://<project_ref>.supabase.co/storage/v1/s3
# - MinIO local/VPS:     http://127.0.0.1:9000
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gettalk-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Konfigurasi SMTP untuk pengiriman email OTP Reset Password ──────────────
# Contoh untuk Gmail: gunakan App Password (16 karakter) dari Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GetTalk Security <no-reply@gettalk.app>"

# ── Reverse Proxy (Nginx) & Cross-Subdomain Cookie (Deploy VPS) ─────────────
# Trust proxy (default: 1 di production agar Express mempercayai X-Forwarded-Proto & X-Forwarded-For dari Nginx)
TRUST_PROXY=1

# Konfigurasi Cookie untuk skenario 2 Subdomain Terpisah (mis. app.domain.com & api.domain.com)
# Di production HTTPS, gunakan COOKIE_SECURE=true dan COOKIE_SAME_SITE=none
COOKIE_SECURE=
COOKIE_SAME_SITE=
COOKIE_DOMAIN=
