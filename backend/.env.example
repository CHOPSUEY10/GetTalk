NODE_ENV=development

HOST=0.0.0.0
PORT=3000

CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gettalk
SESSION_SECRET=change-me-in-production
# Optional dedicated encryption key for MFA secrets; keep it stable and backed up.
MFA_ENCRYPTION_KEY=
REDIS_URL=redis://127.0.0.1:6379

# ── Encrypted Attachment Storage & Pre-signed URLs ──────────────────────────
# STORAGE_DRIVER: 'local' (disk + HMAC pre-signed URL) or 's3' (MinIO / Supabase Storage / R2 / AWS S3)
STORAGE_DRIVER=local
STORAGE_DIR=storage
ATTACHMENT_URL_TTL_SECONDS=300
ATTACHMENT_URL_SECRET=

# S3-compatible configuration (required only when STORAGE_DRIVER=s3):
# - Supabase Storage S3: https://<project_ref>.supabase.co/storage/v1/s3
# - MinIO local/VPS:     http://127.0.0.1:9000
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gettalk-attachments
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Konfigurasi SMTP untuk pengiriman email OTP Reset Password ──────────────
# Contoh untuk Gmail: gunakan App Password (16 karakter) dari Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GetTalk Security <no-reply@gettalk.app>"
