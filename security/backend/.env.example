# ==============================================================================
# GetTalk Security — Backend Environment Configuration (.env.example)
# NEVER commit real credentials, secrets, or keys.
# Dedicated PostgreSQL database required (do NOT reuse main GetTalk DATABASE_URL).
# ==============================================================================

TELEMETRY_ENV=development
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=4100
TELEMETRY_CONFIG_PATH=../configs/telemetry.yaml
TELEMETRY_RULES_PATH=../configs/detection-rules.yaml

# Dedicated PostgreSQL connection string for security telemetry
TELEMETRY_DATABASE_URL=postgresql://telemetry_user:change-me-in-production@127.0.0.1:5432/gettalk_security?sslmode=disable

# Security secrets (minimum 32 characters in production)
TELEMETRY_SESSION_SECRET=change-this-telemetry-session-secret-min-32-chars
TELEMETRY_MFA_ENCRYPTION_KEY=change-this-telemetry-mfa-encryption-key-32-chars

# CORS & Proxy
TELEMETRY_CORS_ORIGINS=http://localhost:5174,https://monitor.gettalk.example
TELEMETRY_TRUSTED_PROXIES=127.0.0.1,::1
TELEMETRY_COOKIE_SECURE=false
TELEMETRY_COOKIE_SAME_SITE=lax

# Optional Bootstrap Administrator (used only when security_admins table is empty in dev/test)
TELEMETRY_BOOTSTRAP_ADMIN_USERNAME=secadmin
TELEMETRY_BOOTSTRAP_ADMIN_EMAIL=secadmin@gettalk.example
TELEMETRY_BOOTSTRAP_ADMIN_PASSWORD=

